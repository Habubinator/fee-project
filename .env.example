# Server
NODE_ENV=development
PORT=3000

# Docker services (used by docker-compose.yml)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=replace_with_strong_password

# PostgreSQL connection string (points to the Docker container on localhost)
DATABASE_URL=postgresql://app:replace_with_strong_password@localhost:5432/app

# Redis (Docker container bound to localhost)
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=replace_with_64_char_random_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_string

# OpenAI (GPT-4o for email parsing + cancel guides)
OPENAI_API_KEY=sk-...

# Monobank Acquiring (Stage 6 — billing)
# Get merchant token: https://web.monobank.ua/ → Merchant settings → API token
# Get test token:     https://api.monobank.ua/
MONOBANK_API_TOKEN=

# Resend (transactional email)
RESEND_API_KEY=re_...

# Firebase Admin SDK (push notifications via FCM)
FIREBASE_PROJECT_ID=example-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google OAuth2 (Gmail read-only access)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Local: http://localhost:3000/v1/auth/gmail/callback
# Prod:  https://api.censored-link.com/v1/auth/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/gmail/callback

# Google Pub/Sub push verification token (set this to any random string,
# then use it in the Pub/Sub subscription URL: ...?token=THIS_VALUE)
PUBSUB_VERIFY_TOKEN=replace_with_random_string
